  },
  "homepage": "https://github.com/Megax800/GalliumServer#readme",
  "dependencies": {
    "aedes": "^0.51.3",
    "express": "^5.2.1",
    "mqtt": "^5.15.0",
    "pnpm": "^10.30.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.2",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
