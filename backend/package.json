{
  "name": "galliumserver",
  "type": "module",
  "version": "1.0.0",
  "description": "Server for chatting through web browser and the Gallium Communicator",
  "main": "app.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc -p ./tsconfig.json",
    "start:dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/src/app.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Megax800/GalliumServer.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Megax800/GalliumServer/issues"
  },
  "homepage": "https://github.com/Megax800/GalliumServer#readme",
  "dependencies": {
    "@mikro-orm/core": "^7.0.9",
    "@mikro-orm/decorators": "^7.0.9",
    "@mikro-orm/mongo-highlighter": "1.0.0",
    "@mikro-orm/mongodb": "^7.0.9",
    "aedes": "^1.1.1",
    "class-validator": "0.15.1",
    "cors": "2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "9.0.3",
    "mqtt": "^5.15.0",
    "pnpm": "^10.30.3",
    "reflect-metadata": "0.2.2",
    "resend": "^6.25.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.2",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.3.1",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
}
