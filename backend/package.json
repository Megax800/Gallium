  "version": "1.0.0",
  "description": "Server for chatting through web browser and the Gallium Communicator",
  "main": "app.js",
  "scripts": {
    "test": "node app.js",
    "build": "tsc -p ./tsconfig.json",
    "start:dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/src/app.js\""
