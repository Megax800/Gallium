{
  "name": "galliumserver",
  "type": "module",
  "version": "1.0.0",
  "description": "Server for chatting through web browser and the Gallium Communicator",
  "main": "main.js",
  "scripts": {
    "test": "node main.js",
    "build": "tsc -p ./tsconfig.json",
    "start:dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/index.js\""
  },
