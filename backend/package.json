    "@mikro-orm/core": "^7.0.9",
    "@mikro-orm/decorators": "^7.0.9",
    "@mikro-orm/mongo-highlighter": "1.0.0",
    "@mikro-orm/mongodb": "^7.0.9",
    "aedes": "^0.51.3",
    "class-validator": "0.15.1",
    "cors": "2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "9.0.3",
    "mqtt": "^5.15.0",
    "nodemailer": "^8.0.4",
