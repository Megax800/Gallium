.................... /* 
....................  
.................... Print a test welcome message on LCD with fixed delay 
....................  
.................... */ 
.................... void lcd_test_print(){ 
....................    lcd_putc("\fLCD 4BIT Driver\n");  
....................    printf(lcd_putc, "     V# %1.2f", LCD_LIB_VER); 
....................    delay_ms(1500); 
....................    lcd_putc("\fDeveloper:"); 
....................    lcd_gotoxy(2,2); 
....................    lcd_putc("Abdul Rehman"); 
....................    delay_ms (1000); 
....................    lcd_putc("\f Compiled On \n "); 
....................    printf(lcd_putc, __DATE__); 
....................    delay_ms(1000); 
....................    lcd_putc("\f"); 
.................... } 
