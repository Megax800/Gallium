....................    #define LCD_DB5   PIN_A3 
....................    #define LCD_DB6   PIN_A6 
....................    #define LCD_DB7   PIN_A7 
....................    #define LCD_E     PIN_A1 
....................    #define LCD_RS    PIN_A0  
